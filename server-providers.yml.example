# Server-managed provider configuration for Nova.
# Copy to server-providers.yml and replace with your credentials.
# Do not commit server-providers.yml or real credentials.

providers:
  # Any OpenAI-compatible endpoint can use the OpenAI provider adapter.
  # This works with OpenAI, Azure-compatible endpoints, or third-party
  # OpenAI-compatible APIs (DeepSeek, Qwen, GLM, etc.)
  openai:
    apiKey: ${OPENAI_API_KEY}
    baseUrl: ${OPENAI_BASE_URL}
    models:
      - gpt-5.6-terra
      # Add more models as needed

  # DeepSeek (OpenAI-compatible)
  # deepseek:
  #   apiKey: ${DEEPSEEK_API_KEY}
  #   baseUrl: https://api.deepseek.com/v1
  #   models:
  #     - deepseek-chat
  #     - deepseek-reasoner

  # Fully local option. Start it with docker compose -f docker-compose.ollama.yml up -d.
  # ollama:
  #   baseUrl: http://ollama:11434/v1
  #   models:
  #     - qwen2.5:7b-instruct

# Optional services use the same shape. Remove sections you do not use.
# tts:
#   openai:
#     apiKey: ${OPENAI_API_KEY}
#   lemonade-tts:
#     baseUrl: http://lemonade:13305/v1
# asr:
#   lemonade-asr:
#     baseUrl: http://lemonade:13305/v1
# web-search:
#   tavily:
#     apiKey: ${TAVILY_API_KEY}
