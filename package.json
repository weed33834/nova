  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "cd packages/mathml2omml && npm run build && cd ../pptxgenjs && npm run build && cd ../@nova/dsl && pnpm run build && cd ../storage && pnpm run build && cd ../importer && pnpm run build && cd ../renderer && pnpm run build && cd ../../.. && pnpm run sync:importer",
    "sync:importer": "node scripts/sync-importer.mjs",
    "dev": "next dev --turbopack",
    "dev:fast": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=4096 next dev --turbopack",
    "build": "node scripts/assert-vendor-importer.mjs && node scripts/pre-build-check.mjs --skip-lint --skip-typecheck && next build",
    "prebuild": "node scripts/pre-build-check.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && pnpm --filter @nova/dsl typecheck && pnpm --filter @nova/storage typecheck && pnpm --filter @nova/renderer typecheck",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "node scripts/load-test.mjs",
    "eval:pbl-v2-planner": "tsx eval/pbl-v2-planner/runner.ts",
    "eval:whiteboard": "tsx eval/whiteboard-layout/runner.ts",
    "eval:outline-language": "tsx eval/outline-language/runner.ts",
    "eval:orchestration": "tsx eval/orchestration/runner.ts",
    "eval:orchestration:answering": "tsx eval/orchestration/answering-runner.ts",
    "eval:orchestration:answer-content": "tsx eval/orchestration/answer-content-runner.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:pg:generate": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:pg:migrate": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "db:pg:studio": "drizzle-kit studio --config=drizzle.pg.config.ts",
    "db:migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
