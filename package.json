  "keywords": [
    "ai",
    "education",
    "classroom",
    "multi-agent",
    "llm",
    "slides",
    "nextjs",
    "react",
    "typescript",
    "langgraph",
    "teaching",
    "course-generator",
    "interactive-learning",
    "open-source"
