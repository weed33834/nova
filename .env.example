# --- Proxy (optional) --------------------------------------------------------

# HTTP_PROXY=
# HTTPS_PROXY=

# --- Misc ---------------------------------------------------------------------

# Server-side default model for API routes like /api/generate-classroom.
# Required for server-side stages (those that don't receive a client x-model):
# resolveModel throws if a stage resolves to no model (no MODEL_ROUTES entry, no
# x-model, no DEFAULT_MODEL) — there is intentionally no hardcoded vendor fallback.
# Example: anthropic:claude-3-5-haiku-20241022 or google:gemini-3-flash-preview
# OpenAI example: openai:gpt-5.5
# MiniMax example: minimax:MiniMax-M2.7-highspeed
DEFAULT_MODEL=

# Optional per-stage model routing (#745). A JSON object mapping a generation
# stage to a model string (`provider:model`). Resolution order for a stage:
# stage route > x-model (client) > DEFAULT_MODEL. A configured route is the
# operator's deliberate choice and wins even when the browser sends its saved
# model as x-model. Unset = identical to today (everything uses DEFAULT_MODEL).
# Unlisted stages fall back to x-model then DEFAULT_MODEL, so you can override
# just one or two and leave the rest to the client/default.
# Point a stage only at a server-configured provider (its key resolvable); a
# route to an unconfigured/invalid model fails at request time for that stage,
# the same way a bad DEFAULT_MODEL would (no startup validation).
# Routable stages: scene-outlines-stream, scene-content, scene-actions,
# agent-profiles, quiz-grade, pbl-chat, chat-adapter, generate-classroom,
# web-search-query-rewrite.
# scene-content can also be routed per scene type with composite keys:
# scene-content:slide, scene-content:quiz, scene-content:interactive,
# scene-content:pbl. A type falls back to the base scene-content route when it
# has no key of its own (so scene-content:<type> > scene-content > x-model >
# DEFAULT_MODEL).
# A route value can be a model string, OR an object {"model","thinking"} where
# `thinking` is the full ThinkingConfig: mode (default|disabled|enabled|auto),
# effort (none|minimal|low|medium|high|xhigh|max), level (minimal|low|medium|
# high, Gemini), enabled (bool), budgetTokens (number), excludeReasoningOutput
# (bool). It is normalized per the model's capability. When a stage is routed:
# a set `thinking` wins over the client's thinking; with no `thinking` the routed
# model uses its own default and the client's thinking is dropped. Unrouted
# stages keep the client thinking.
# Example: cheap default, stronger model only for the heavy/conversational stages:
# MODEL_ROUTES='{"scene-content":"openai:gpt-5.4","scene-actions":"openai:gpt-5.4","pbl-chat":"anthropic:claude-sonnet-4","chat-adapter":"anthropic:claude-sonnet-4"}'
# Example: per scene type + pinned thinking (qwen budget, deepseek off):
# MODEL_ROUTES='{"scene-content:interactive":{"model":"qwen:qwen3.7-plus","thinking":{"enabled":true,"budgetTokens":8000}},"scene-content:quiz":{"model":"deepseek:deepseek-v4-pro","thinking":{"enabled":false}}}'
# MODEL_ROUTES=

# Optional provider/model failover chain. A comma-separated, ORDERED list of
# model strings (provider:model) tried in sequence when the primary (resolved)
# model fails with a *retryable* error (5xx, timeout, network). Non-retryable
# failures (4xx: bad request, auth, model-not-found, rate-limit) are NOT fallen
# over — another model would not help and could mask a config problem. Unset =
# no failover (today's behavior). This is a separate layer from the AI SDK's
# built-in maxRetries, which already retries the SAME model with backoff; the
# fallback chain only kicks in after those same-model retries are exhausted.
# Each fallback resolves its own credentials from server config (managed
# providers) or the client's key (unmanaged), so list only models whose
# providers are reachable. The primary model is never retried.
# Example: openai:gpt-5.4,anthropic:claude-sonnet-4,google:gemini-3-flash-preview
# FALLBACK_MODELS=

# LLM call timeout in milliseconds (default 120000). Complex scene-content
# generation can take 20–120 s per slide; leave headroom for retries.
# LLM_TIMEOUT_MS=300000

# Enable Pro editing mode (classroom "编辑课程" switch / quiz answering UI).
# Must be set at BUILD time (inlined into the client bundle by Next.js).
# NEXT_PUBLIC_NOVA_EDITOR_ENABLED=true

# LOG_LEVEL=info
# LOG_FORMAT=pretty
# LLM_THINKING_DISABLED=false

# Opt-in parallel scene-content generation (#572). 0/unset = serial (default).
# A value > 1 fetches scene content concurrently (capped at 10); actions + TTS
# stay serial. Leave off if your API key has a low per-key concurrency quota.
# PARALLEL_SCENE_CONCURRENCY=3

# --- Local/Self-hosted Deployment ---------------------------------------------
# Set to "true" to allow private/local network URLs (e.g. localhost, 192.168.x.x).
# Required for self-hosted models like Ollama. Do NOT enable on public deployments.
# ALLOW_LOCAL_NETWORKS=true

# --- Access Control -----------------------------------------------------------
# Set a password to restrict site access. When set, users must enter this code
# before using the app. Leave empty or remove to disable access control.
# ACCESS_CODE=your-secret-code

# --- Authentication -----------------------------------------------------------
# Required in production: secret used to sign NextAuth JWTs.
# Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=

# Optional: GitHub OAuth provider
# GITHUB_ID=
# GITHUB_SECRET=
# NEXT_PUBLIC_GITHUB_ENABLED=true

# Optional: Google OAuth provider
# GOOGLE_ID=
# GOOGLE_SECRET=
# NEXT_PUBLIC_GOOGLE_ENABLED=true

# --- Enterprise SSO (OIDC + SAML) ---------------------------------------------
# Configure enterprise single sign-on for corporate authentication.
# Two protocols are supported: OIDC (recommended) and SAML 2.0.
#
# OIDC Provider (works with Azure AD, Okta, Keycloak, Auth0, etc.):
# The issuer URL is the base URL of your IdP's OIDC endpoint.
# Examples:
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
#   Okta:      https://{org}.okta.com
#   Keycloak:  https://keycloak.example.com/realms/{realm}
#   Auth0:     https://{tenant}.auth0.com
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_NAME=Enterprise SSO  # Display name on the sign-in page
# SSO_OIDC_SCOPES=openid email profile  # Default scopes
#
# SAML 2.0 Provider (for organizations that only support SAML):
# Install the optional dependency: pnpm add @node-saml/passport-saml
# Then configure:
# SSO_SAML_ENTRY_ID=https://idp.example.com/sso  # IdP SSO endpoint URL
# SSO_SAML_IDP_SSO_URL=https://idp.example.com/sso  # IdP SSO redirect URL (optional, defaults to entry ID)
# SSO_SAML_IDP_CERT=  # IdP signing certificate (PEM format, without headers)
# SSO_SAML_CERT=  # SP signing certificate (for signed AuthnRequests, optional)
# SSO_SAML_PRIVATE_KEY=  # SP private key (for signed AuthnRequests, optional)
# SSO_SAML_NAME=SAML SSO  # Display name on the sign-in page
#
# SAML endpoints exposed by Nova:
#   SP Metadata:   GET  /api/auth/saml/metadata
#   Login init:    GET  /api/auth/saml/login
#   ACS callback:  POST /api/auth/saml/acs
#
# Register these URLs with your IdP to establish trust.

# --- Security Headers (optional) ---------------------------------------------
# HSTS max-age in seconds (default: 63072000 = 2 years)
# HSTS_MAX_AGE=63072000
# Enable HSTS preload (one-way commitment, requires domain registration)
# HSTS_PRELOAD=false
# Additional allowed frame ancestors (for embedding in other apps)
# ALLOWED_FRAME_ANCESTORS=https://your-lms.example.com

# --- Rate Limiting ------------------------------------------------------------
# Rate limits are enforced in-memory by default. For multi-instance deployments,
# configure Upstash Redis for distributed rate limiting.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Audit Log Retention ------------------------------------------------------
# Number of days to retain audit log entries before automatic deletion.
# Default: 90 days. Set to 0 to disable pruning (not recommended for production).
# AUDIT_LOG_RETENTION_DAYS=90

# --- CORS (Cross-Origin Resource Sharing) -------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# When unset, defaults to same-origin only (secure default).
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
# CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-API-Key, X-Request-ID
# CORS_MAX_AGE=86400

# --- Error Tracking (Sentry) --------------------------------------------------
# Set SENTRY_DSN to enable server-side error tracking (opt-in).
# Set NEXT_PUBLIC_SENTRY_DSN to enable client-side error tracking.
# When unset, Sentry is completely disabled (no overhead).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Trace sample rate (0.0 - 1.0, default: 0.1)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiles sample rate (server only, default: 0.1)
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# Session replay sample rate (client only, default: 0.1)
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
# Sentry auth token for source map uploads during build
# SENTRY_AUTH_TOKEN=

# --- OpenTelemetry Tracing ---------------------------------------------------
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable distributed tracing via OTLP.
# Works with Jaeger, Tempo, Honeycomb, Datadog, Grafana Faro, etc.
# When unset, tracing is disabled (no overhead).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nova
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>

# --- Object Storage (S3-compatible) -------------------------------------------
# Configure to enable cloud storage for media files (AWS S3, Alibaba OSS,
# Cloudflare R2, MinIO, etc.). When unset, falls back to IndexedDB.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com  # Optional CDN URL

# --- Email Notification (SMTP) ------------------------------------------------
# Configure to enable email notifications (welcome, password reset, etc.).
# When unset, all email functions silently skip.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Nova <noreply@example.com>

# --- User Quota Management ----------------------------------------------------
# Monthly usage limits per user. Admin role is exempt.
# QUOTA_LLM_CALLS=1000
# QUOTA_IMAGE_GEN=100
# QUOTA_VIDEO_GEN=20
# QUOTA_TTS_CHARS=50000

# --- Webhook Notifications ----------------------------------------------------
# Optional secret for signing outbound webhooks (HMAC-SHA256).
# WEBHOOK_SECRET=

# --- Prometheus Metrics -------------------------------------------------------
# Token to protect the /api/metrics endpoint.
# When set, metrics require `Authorization: Bearer <METRICS_TOKEN>`.
# When unset but ACCESS_CODE is set, metrics use `?token=<ACCESS_CODE>`.
# When both are unset, metrics are public (development only).
# METRICS_TOKEN=

# --- Database Backup ----------------------------------------------------------
# Path to the SQLite database file (default: data/nova.db)
# NOVA_DB_PATH=data/nova.db
# Directory for database backups (default: data/backups)
# NOVA_BACKUP_DIR=data/backups
# Number of backups to retain (default: 30)
# NOVA_BACKUP_RETENTION=30

# --- PostgreSQL (Optional Database Backend) -----------------------------------
# Set DATABASE_URL to a PostgreSQL connection string to switch from the
# default SQLite database to PostgreSQL. The app automatically detects the
# database type and uses the appropriate driver.
#
# When using PostgreSQL:
#   1. Install the driver: pnpm add postgres
#   2. Set DATABASE_URL
#   3. Run migrations: pnpm db:pg:migrate
#   4. (Optional) Migrate existing data: pnpm db:migrate:sqlite-to-pg
#
# Connection string format:
#   postgresql://user:password@host:5432/database?sslmode=require
#
# DATABASE_URL=postgresql://user:password@localhost:5432/nova
#
# Connection pool size (default: 10)
# PG_POOL_MAX=10
# Connection timeout in seconds (default: 30)
# PG_CONNECT_TIMEOUT=30
# Statement timeout in milliseconds (default: unset = no timeout)
# PG_STATEMENT_TIMEOUT=30000
# Force SSL on/off (default: auto-detect from connection string)
# PG_SSL=true
# PG_SSL=false

# --- Aliyun Docmind PDF Parser ------------------------------------------------
# Optional: Aliyun Docmind for PDF document parsing.
# ALIDOCMIND_ACCESS_KEY_ID=
# ALIDOCMIND_ACCESS_KEY_SECRET=
# ALIDOCMIND_BASE_URL=

# --- Security & Auth Tuning ---------------------------------------------------
# Bcrypt rounds for password hashing (default: 12)
# NOVA_BCRYPT_ROUNDS=12

# --- Feature Flags ------------------------------------------------------------
# Environment-variable-driven feature toggling. Use FEATURE_* prefix.
# Boolean values: true/1/yes = enabled, false/0/no = disabled.
# String/number values are passed through as-is.
# Unset flags default to false (features are opt-in).
#
# Examples:
# FEATURE_VIDEO_EXPORT=true
# FEATURE_EXPERIMENTAL_MODEL_ROUTING=false
# FEATURE_QUOTA_LIMIT=1000
# FEATURE_MAX_SCENES=50

# Disable PBL v2 (Project-Based Learning) endpoints
# PBL_V2_DISABLED=false

# --- Network Proxy ------------------------------------------------------------
# Comma-separated host patterns to bypass proxy (e.g. internal services)
# NO_PROXY=

# --- Client-Side Public Config ------------------------------------------------
# Expose MCP server in the browser
# NEXT_PUBLIC_MCP_EXPOSE=false
# Disable MCP stdio transport in the browser
# NEXT_PUBLIC_MCP_STDIO_DISABLED=false
# Show vocational test UI (feature flag)
# NEXT_PUBLIC_SHOW_VOCATIONAL_TEST_UI=false
# Public app URL for share links and SSR
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel environment (auto-set by Vercel)
# NEXT_PUBLIC_VERCEL_ENV=
